{
  "id": "justflight-bae146",
  "name": "Just Flight BAe 146 / Avro RJ",
  "description": "Just Flight BAe 146 and Avro RJ on MSFS. Reads the mode control panel annunciators from the aircraft's variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). SimConnect reads local variables directly since Sim Update 12, so these bindings are live; the stock simulation variable stays behind each one as the fallback for older simulator builds.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "146|avro\\s*rj"
      }
    ]
  },
  "mash": {
    "autopilot.master": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MCP_Mode_AP_iL"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT MASTER",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "autopilot.navLock": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MCP_Mode_LNAV_iL"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT NAV1 LOCK",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ]
  }
}
