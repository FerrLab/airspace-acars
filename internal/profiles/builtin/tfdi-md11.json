{
  "id": "tfdi-md11",
  "name": "TFDi MD-11",
  "description": "TFDi Design MD-11 on MSFS. Reads the flight guidance and the APU from the MD11 state variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). Local variables need the WASM bridge; every binding that uses one falls back to the stock simulation variable, which is what runs today. MD11_AFS_STATE is 0 off, 1 AP1, 2 AP2, 3 both; MD11_APU_STATE is 0 off, 1 starting, 2 running, 3 shutting down.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "md\\s*-?11"
      }
    ]
  },
  "mash": {
    "autopilot.master": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_STATE"
        },
        "transform": [
          {
            "op": "gte",
            "value": 1
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT MASTER",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "apu.switchOn": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_APU_STATE"
        },
        "transform": [
          {
            "op": "gte",
            "value": 1
          },
          {
            "op": "lte",
            "value": 2
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "APU SWITCH",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "apu.rpmPercent": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_APU_N1"
        },
        "transform": [
          {
            "op": "clamp",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "APU PCT RPM",
          "unit": "Percent"
        }
      }
    ],
    "aircraft.type": {
      "source": {
        "kind": "const",
        "value": "MD11"
      }
    }
  }
}
