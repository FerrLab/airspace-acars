{
  "id": "tfdi-md11",
  "name": "TFDi MD-11",
  "description": "TFDi Design MD-11 on MSFS. Reads the flight guidance and the APU from the MD11 state variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). SimConnect reads local variables directly since Sim Update 12, so these bindings are live; the stock simulation variable stays behind each one as the fallback for older simulator builds. MD11_AFS_STATE is 0 off, 1 AP1, 2 AP2, 3 both; MD11_APU_STATE is 0 off, 1 starting, 2 running, 3 shutting down; only 1 and 2 count as on, and the map spells that out because a transform is a pipeline rather than a set of conditions that are anded together.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "md\\s*-?11"
      }
    ]
  },
  "mash": {
    "autopilot.master": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_STATE"
        },
        "transform": [
          {
            "op": "gte",
            "value": 1
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT MASTER",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "apu.switchOn": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_APU_STATE"
        },
        "transform": [
          {
            "op": "map",
            "map": {
              "1": 1,
              "2": 1
            },
            "default": 0
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "APU SWITCH",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "apu.rpmPercent": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_APU_N1"
        },
        "transform": [
          {
            "op": "clamp",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "APU PCT RPM",
          "unit": "Percent"
        }
      }
    ],
    "aircraft.type": {
      "source": {
        "kind": "const",
        "value": "MD11"
      }
    },
    "autopilot.heading": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_HDG"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT HEADING LOCK DIR",
          "unit": "degrees"
        }
      }
    ],
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_ALT"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT ALTITUDE LOCK VAR",
          "unit": "feet"
        }
      }
    ],
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_VS"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT VERTICAL HOLD VAR",
          "unit": "feet per minute"
        }
      }
    ],
    "autopilot.speed": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MD11_AFS_SPD"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT AIRSPEED HOLD VAR",
          "unit": "knots"
        }
      }
    ]
  }
}
