{
  "id": "inibuilds-a300",
  "name": "iniBuilds A300",
  "description": "iniBuilds A300-600 on MSFS. Reads the autopilot engagement from the iniBuilds variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). Local variables need the WASM bridge; every binding that uses one falls back to the stock simulation variable, which is what runs today.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "ini\\s*-?builds?|inisim"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "a\\s*-?300"
      }
    ]
  },
  "mash": {
    "autopilot.master": {
      "reduce": "or",
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap1_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap2_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_cmd_light"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT MASTER",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ]
    }
  }
}
