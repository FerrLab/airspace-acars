{
  "id": "inibuilds-a300",
  "name": "iniBuilds A300",
  "description": "iniBuilds A300-600 on MSFS. Reads the autopilot engagement from the iniBuilds variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). SimConnect reads local variables directly since Sim Update 12, so these bindings are live; the stock simulation variable stays behind each one as the fallback for older simulator builds.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "ini\\s*-?builds?|inisim"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "a\\s*-?300"
      }
    ]
  },
  "mash": {
    "autopilot.master": {
      "reduce": "or",
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap1_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap2_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_cmd_light"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT MASTER",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ]
    },
    "autopilot.heading": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_HEADING_DIAL"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT HEADING LOCK DIR",
          "unit": "degrees"
        }
      }
    ],
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_Altitude_Dial"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT ALTITUDE LOCK VAR",
          "unit": "feet"
        }
      }
    ],
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_vvi_dial"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT VERTICAL HOLD VAR",
          "unit": "feet per minute"
        }
      }
    ],
    "autopilot.speed": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_Airspeed_Dial"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT AIRSPEED HOLD VAR",
          "unit": "knots"
        }
      }
    ]
  }
}
