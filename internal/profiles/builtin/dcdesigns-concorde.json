{
  "description": "DC Designs Concorde. Reads the data points below from the aircraft's own variables instead of the stock ones.",
  "id": "dcdesigns-concorde",
  "mash": {
    "autopilot.master": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "XMLVAR_Autopilot_1_Status"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "XMLVAR_Autopilot_2_Status"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT MASTER",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    }
  },
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "dc\\s*-?designs"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "concorde"
      }
    ]
  },
  "name": "DC Designs Concorde",
  "notes": "Generated by `go run ./cmd/hubhop gen` from the MobiFlight HubHop community database. The selector and the bindings have not been confirmed in the simulator: treat this as a starting point, and correct it in place once flown. Every binding falls back to the stock variable, so an unread aircraft variable costs nothing.",
  "priority": 50,
  "x-generated": true
}
