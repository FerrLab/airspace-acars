{
  "id": "aerosoft-crj",
  "name": "Aerosoft CRJ 550/700/900/1000",
  "description": "Aerosoft CRJ on MSFS. Reads the flight control panel modes, the beacon and the gear from the CRJ variables.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). SimConnect reads local variables directly since Sim Update 12, so these bindings are live; the stock simulation variable stays behind each one as the fallback for older simulator builds.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "crj"
      }
    ]
  },
  "mash": {
    "autopilot.navLock": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "ASCRJ_FCP_NAV_LED"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT NAV1 LOCK",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "autopilot.approachHold": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "ASCRJ_FCP_APPR_LED"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT APPROACH HOLD",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ],
    "controls.gearDown": {
      "reduce": "and",
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "ASCRJ_GEAR_NOSE_POS"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "ASCRJ_GEAR_LEFT_POS"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "ASCRJ_GEAR_RIGHT_POS"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "GEAR HANDLE POSITION",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ]
    }
  }
}
