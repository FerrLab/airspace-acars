{
  "description": "BlueBird Simulations B757. Reads the data points below from the aircraft's own variables instead of the stock ones.",
  "id": "bluebird-simulations-b757",
  "mash": {
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "BBS_AP_TARGET_ALTITUDE"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT ALTITUDE LOCK VAR",
          "unit": "feet"
        }
      }
    ],
    "autopilot.approachHold": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "B757_MCP_APP_BUTTON"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT APPROACH HOLD",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    },
    "autopilot.heading": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "BBS_AP_TARGET_HEADING"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT HEADING LOCK DIR",
          "unit": "degrees"
        }
      }
    ],
    "autopilot.navLock": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "B757_MCP_LNAV_BUTTON"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT NAV1 LOCK",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    },
    "autopilot.speed": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "BBS757_ORANGE_AIRSPEED_BUGS"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT AIRSPEED HOLD VAR",
          "unit": "knots"
        }
      }
    ],
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "BBS_AP_TARGET_VS"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT VERTICAL HOLD VAR",
          "unit": "feet/minute"
        }
      }
    ]
  },
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "bluebird"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "b[\\s-]*757"
      }
    ]
  },
  "name": "BlueBird Simulations B757",
  "notes": "Generated by `go run ./cmd/hubhop gen` from the MobiFlight HubHop community database. The selector and the bindings have not been confirmed in the simulator: treat this as a starting point, and correct it in place once flown. Every binding falls back to the stock variable, and a local variable the aircraft does not define is withheld rather than read as zero, so a wrong name costs nothing.",
  "priority": 50,
  "x-generated": true
}
