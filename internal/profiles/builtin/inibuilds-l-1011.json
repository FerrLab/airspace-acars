{
  "description": "IniBuilds L-1011. Reads the data points below from the aircraft's own variables instead of the stock ones.",
  "id": "inibuilds-l-1011",
  "mash": {
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
