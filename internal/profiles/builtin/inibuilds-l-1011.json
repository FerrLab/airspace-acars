        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_HEADING_PID_SETPOINT"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT HEADING LOCK DIR",
          "unit": "degrees"
        }
      }
    ],
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_VS_PID_SETPOINT_2"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
