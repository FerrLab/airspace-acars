{
  "description": "Aerosoft A340-600. Reads the data points below from the aircraft's own variables instead of the stock ones.",
  "id": "aerosoft-a340-600",
  "mash": {
    "apu.switchOn": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "AB_VC_OVH_APU_MASTER_ON"
          },
          "transform": [
            {
              "op": "gt",
              "value": 0
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "APU SWITCH",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    },
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "TLS_FCU_ALT_WINDOW_VALUE"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT ALTITUDE LOCK VAR",
          "unit": "feet"
        }
      }
    ],
    "autopilot.heading": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "TLS_FCU_HDG_WINDOW_VALUE"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT HEADING LOCK DIR",
          "unit": "degrees"
        }
      }
    ],
    "autopilot.speed": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "TLS_FCU_SPD_WINDOW_VALUE"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT AIRSPEED HOLD VAR",
          "unit": "knots"
        }
      }
    ],
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "TLS_FCU_VS_WINDOW_VALUE"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT VERTICAL HOLD VAR",
          "unit": "feet/minute"
        }
      }
    ]
  },
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "aerosoft"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "a[\\s-]*340"
      }
    ]
  },
  "name": "Aerosoft A340-600",
  "notes": "Generated by `go run ./cmd/hubhop gen` from the MobiFlight HubHop community database. The selector and the bindings have not been confirmed in the simulator: treat this as a starting point, and correct it in place once flown. Every binding falls back to the stock variable, and a local variable the aircraft does not define is withheld rather than read as zero, so a wrong name costs nothing.",
  "priority": 50,
  "x-generated": true
}
