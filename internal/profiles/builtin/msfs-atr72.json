{
  "id": "msfs-atr72",
  "name": "ATR 42-600 / 72-600",
  "description": "The Microsoft/Asobo ATR on MSFS. Reads the gear from the three down annunciators and the approach mode from the flight guidance panel.",
  "notes": "Variable names cross-checked against the MobiFlight HubHop community database (hubhop.mobiflight.com). Local variables need the WASM bridge; every binding that uses one falls back to the stock simulation variable, which is what runs today.",
  "priority": 100,
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "atr\\s*-?[47]2"
      }
    ]
  },
  "mash": {
    "controls.gearDown": {
      "reduce": "and",
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "MSATR_GEAR_NOSE_DOWN_LT"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "MSATR_GEAR_LEFT_DOWN_LT"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "MSATR_GEAR_RIGHT_DOWN_LT"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "GEAR HANDLE POSITION",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ]
    },
    "autopilot.approachHold": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "MSATR_FGCP_STAT_APP_L"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT APPROACH HOLD",
          "unit": "Bool"
        },
        "transform": [
          {
            "op": "bool"
          }
        ]
      }
    ]
  }
}
