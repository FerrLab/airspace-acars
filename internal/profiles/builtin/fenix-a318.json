{
  "id": "fenix-a318",
  "name": "Fenix A318",
  "description": "Reports the ICAO type A318 for the Fenix A318. The systems bindings come from the fenix-a32x family profile.",
  "priority": 110,
  "match": {
    "all": [
      { "field": "simulator", "op": "equals", "value": "simconnect" },
      { "field": "aircraftName", "op": "contains", "value": "fenix" },
      { "field": "aircraftName", "op": "matches", "value": "a\\s*-?318" }
    ]
  },
  "mash": {
    "aircraft.type": { "source": { "kind": "const", "value": "A318" } }
  }
}
