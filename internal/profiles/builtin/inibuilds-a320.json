{
  "description": "IniBuilds A320. Reads the data points below from the aircraft's own variables instead of the stock ones.",
  "id": "inibuilds-a320",
  "mash": {
    "autopilot.altitude": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_Altitude_Dial"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT ALTITUDE LOCK VAR",
          "unit": "feet"
        }
      }
    ],
    "autopilot.approachHold": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_APPROACH_BUTTON"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT APPROACH HOLD",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    },
    "autopilot.master": {
      "bindings": [
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap1_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "lvar",
            "name": "INI_ap2_on"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        },
        {
          "sim": "simconnect",
          "source": {
            "kind": "simvar",
            "name": "AUTOPILOT MASTER",
            "unit": "Bool"
          },
          "transform": [
            {
              "op": "bool"
            }
          ]
        }
      ],
      "reduce": "or"
    },
    "autopilot.vs": [
      {
        "sim": "simconnect",
        "source": {
          "kind": "lvar",
          "name": "INI_vvi_dial"
        }
      },
      {
        "sim": "simconnect",
        "source": {
          "kind": "simvar",
          "name": "AUTOPILOT VERTICAL HOLD VAR",
          "unit": "feet/minute"
        }
      }
    ]
  },
  "match": {
    "all": [
      {
        "field": "simulator",
        "op": "equals",
        "value": "simconnect"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "ini\\s*-?builds?|inisim"
      },
      {
        "field": "aircraftName",
        "op": "matches",
        "value": "a[\\s-]*320"
      }
    ]
  },
  "name": "IniBuilds A320",
  "notes": "Generated by `go run ./cmd/hubhop gen` from the MobiFlight HubHop community database. The selector and the bindings have not been confirmed in the simulator: treat this as a starting point, and correct it in place once flown. Every binding falls back to the stock variable, so an unread aircraft variable costs nothing.",
  "priority": 50,
  "x-generated": true
}
